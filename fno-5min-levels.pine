//@version=6
indicator("FnO-levels", overlay=true)

// --- Settings & Toggles ---
grpToggles = "Level Toggles"
showPrevDaily = input.bool(true, title="Show Previous Day (High/Low/Close)", group=grpToggles)
showPrev5Min  = input.bool(true, title="Show Previous 5-Min (High/Low)", group=grpToggles)
showToday5Min = input.bool(true, title="Show Today's 5-Min (High/Low)", group=grpToggles)
showRoundNums = input.bool(false, title="Show Round Numbers", group=grpToggles)

grpRound = "Round Number Settings"
colorRound = input.color(color.new(color.fuchsia, 30), title="Round Number Color", group=grpRound)

// --- Dynamic Step Size Logic ---
get_dynamic_step(float p) =>
    if p < 50
        5
    else if p < 200
        10
    else if p < 1000
        50
    else if p < 5000
        100
    else if p < 15000
        250
    else
        500

roundStep = get_dynamic_step(close)

// --- Detect New Trading Day (Timeframe safe) ---
bool isNewDay = ta.change(time("D")) != 0

// --- 5-Minute First Bar Levels ---
var float curr5h = na
var float curr5l = na
var float prev5h = na
var float prev5l = na

if isNewDay
    prev5h := curr5h
    prev5l := curr5l
    curr5h := high
    curr5l := low
else if time - ta.valuewhen(isNewDay, time, 0) < 5 * 60 * 1000
    curr5h := math.max(nz(curr5h, high), high)
    curr5l := math.min(nz(curr5l, low), low)

// --- Daily High, Low, Close (Safe across views) ---
isIntraday = timeframe.isintraday
pdh = request.security(syminfo.tickerid, "D", high[1], ignore_invalid_symbol=true)
pdl = request.security(syminfo.tickerid, "D", low[1], ignore_invalid_symbol=true)
pdc = request.security(syminfo.tickerid, "D", close[1], ignore_invalid_symbol=true)

// Calculate ATR globally to avoid scope warnings inside the islast block
atr = ta.atr(14)

// --- Map Aggregation Logic for Decluttering ---
method add_level(map<float, string> mNames, map<float, color> mColors, float price, string name, color col) =>
    if not na(price)
        if mNames.contains(price)
            mNames.put(price, mNames.get(price) + " / " + name)
            mColors.put(price, color.white)
        else
            mNames.put(price, name)
            mColors.put(price, col)

// --- Draw End-to-End Decluttered Lines & Labels ---
if barstate.islast
    mapNames = map.new<float, string>()
    mapColors = map.new<float, color>()
    
    colorPrev = color.new(color.silver, 0)
    colorToday = color.new(color.white, 0)

    if showPrevDaily and not na(pdh)
        mapNames.add_level(mapColors, pdh, "prev day high", colorPrev)
        mapNames.add_level(mapColors, pdl, "prev-day-low", colorPrev)
        mapNames.add_level(mapColors, pdc, "prev-close", colorPrev)
        
    if showPrev5Min and isIntraday
        mapNames.add_level(mapColors, prev5h, "prev 5 min high", colorPrev)
        mapNames.add_level(mapColors, prev5l, "prev-5min-low", colorPrev)
        
    if showToday5Min and isIntraday
        mapNames.add_level(mapColors, curr5h, "today 5 min high", colorToday)
        mapNames.add_level(mapColors, curr5l, "today 5 min low", colorToday)

    if showRoundNums and roundStep > 0
        baseRound = math.floor(close / roundStep) * roundStep
        for i = -1 to 2
            rnPrice = baseRound + (i * roundStep)
            rnLabel = str.tostring(rnPrice)
            mapNames.add_level(mapColors, rnPrice, rnLabel, colorRound)

    // Protected X-coordinates to prevent negative indexing
    int safeXStart = math.max(0, bar_index - 1)
    
    arrPrices = mapNames.keys()
    arrPrices.sort() // Sort prices lowest to highest for distance checking
    
    // Dynamic collision threshold based on current volatility
    float threshold = nz(atr, close * 0.002) * 0.25 
    
    int currentOffset = 30
    for i = 0 to arrPrices.size() - 1
        p = arrPrices.get(i)
        n = mapNames.get(p)
        c = mapColors.get(p)
        
        // Push labels iteratively further left if they share similar price territory
        if i > 0
            prevP = arrPrices.get(i - 1)
            if math.abs(p - prevP) < threshold
                currentOffset += 40
            else
                currentOffset := 30
        else
            currentOffset := 30
            
        int safeLabelX = math.max(0, bar_index - math.min(currentOffset, bar_index))
        
        line.new(safeXStart, p, bar_index, p, color=c, style=line.style_dotted, extend=extend.both)
        label.new(safeLabelX, p, text=n, style=label.style_none, textcolor=c, size=size.small)
